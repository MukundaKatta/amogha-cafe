rules_version = '2';

// =============================================================================
// AMOGHA CAFE — FIRESTORE SECURITY RULES
// =============================================================================
//
// IMPORTANT SECURITY NOTE:
// The customer-facing app uses a custom phone+PIN system, NOT Firebase Auth,
// so request.auth is null for customer flows and only field-level validation
// is possible there.
//
// The ADMIN panel does use Firebase Auth: it signs in with a custom token
// minted by POST /auth/admin-login (functions/index.js), and that token
// carries the {admin: true} custom claim. Admin-writeable collections check
// request.auth.token.admin == true so a tab without that session can't
// write — even if it has the password.
//
// Rule layout:
//   - Customer-driven writes (orders, users, etc.): field-validated, no auth.
//   - Admin-only writes (menu, heroSlides, settings, shops, kiosks):
//     require request.auth.token.admin == true. Field validation kept as
//     defense in depth.
//   - Read-only collections (specials, addons, testimonials, socialPosts):
//     allow write: if false — admin manages these via Firebase Console or
//     a future admin endpoint.
//   - settings/adminConfig: read BLOCKED. The doc holds the admin password
//     hash + salt; only the Admin SDK in Cloud Functions touches it.
// =============================================================================

// Reused predicate: the request carries an admin custom claim.
// Use only inside `match` blocks. Kept as a comment-doc here; inlined below
// because Firestore rules functions can't be defined at file scope.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPER FUNCTIONS
    // -------------------------------------------------------------------------

    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isString(val) {
      return val is string && val.size() > 0;
    }

    function isNumber(val) {
      return val is number;
    }

    // True if the request carries the admin custom claim (minted by the
    // /auth/admin-login Cloud Function and attached via signInWithCustomToken
    // in the admin panel).
    function isAdmin() {
      return request.auth != null
             && request.auth.token.admin == true;
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    match /users/{phone} {
      allow read: if true;
      allow create: if hasFields(['name', 'phone', 'createdAt'])
                    && isString(request.resource.data.name)
                    && isString(request.resource.data.phone)
                    && request.resource.data.phone == phone
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.phone.size() == 10;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone', 'pin', 'createdAt'])
                    && request.resource.data.keys().size() <= 20;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // ORDERS
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if true;
      allow create: if hasFields(['items', 'total', 'customer', 'phone', 'status', 'createdAt'])
                    && isString(request.resource.data.customer)
                    && isString(request.resource.data.phone)
                    && isNumber(request.resource.data.total)
                    && request.resource.data.total > 0
                    && request.resource.data.total < 100000
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.customer.size() <= 100
                    && (request.resource.data.phone.size() == 10
                        || request.resource.data.orderType == 'pos')
                    && request.resource.data.status in ['pending', 'preparing', 'ready', 'delivered', 'cancelled', 'scheduled']
                    && (!request.resource.data.keys().hasAny(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','kitchenStartedAt','preparingAt','etaMinutes','readyAt',
                                   'deliveredAt','scheduledFor','deliveryPerson','outForDeliveryAt',
                                   'driverLocation','splitBill','voidedAt','phone'])
                    && request.resource.data.status in ['pending', 'preparing', 'ready', 'delivered', 'cancelled', 'scheduled', 'voided'];
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // MENU — readable by all, updatable by admin panel
    // -------------------------------------------------------------------------
    match /menu/{itemId} {
      allow read: if true;
      // Admin Firebase Auth claim required. Field validation kept as
      // defense in depth — if the claim check is ever weakened, the type
      // and bounds checks still apply.
      allow create: if isAdmin()
                    && hasFields(['name', 'price', 'category'])
                    && isString(request.resource.data.name)
                    && request.resource.data.name.size() <= 200
                    && isString(request.resource.data.category)
                    && request.resource.data.category.size() <= 100
                    && isNumber(request.resource.data.price)
                    && request.resource.data.price > 0
                    && request.resource.data.price < 100000;
      allow update: if isAdmin()
                    && (!request.resource.data.keys().hasAny(['price'])
                       || (isNumber(request.resource.data.price)
                           && request.resource.data.price > 0
                           && request.resource.data.price < 100000))
                    && (!request.resource.data.keys().hasAny(['name'])
                        || (isString(request.resource.data.name)
                            && request.resource.data.name.size() <= 200));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SPECIALS — read-only from client
    // -------------------------------------------------------------------------
    match /specials/{specialId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // HERO SLIDES — admin writable for slideshow management
    // -------------------------------------------------------------------------
    match /heroSlides/{slideId} {
      allow read: if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['url', 'type', 'sortOrder', 'active'])
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 2000
                    && request.resource.data.type is string
                    && request.resource.data.type in ['image', 'video']
                    && request.resource.data.sortOrder is number
                    && request.resource.data.active is bool;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['url', 'type', 'sortOrder', 'active', 'caption', 'updatedAt'])
                    && (!request.resource.data.keys().hasAny(['url'])
                        || (request.resource.data.url is string && request.resource.data.url.size() <= 2000))
                    && (!request.resource.data.keys().hasAny(['type'])
                        || request.resource.data.type in ['image', 'video']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ADDONS — read-only from client
    // -------------------------------------------------------------------------
    match /addons/{addonId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TESTIMONIALS — read-only from client
    // -------------------------------------------------------------------------
    match /testimonials/{tid} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SOCIAL POSTS — read-only from client
    // -------------------------------------------------------------------------
    match /socialPosts/{postId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SETTINGS — readable by all, writable by admin panel
    // Only known document IDs (global, adminConfig, etc.) may be created/updated
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      // adminConfig holds the admin password hash + salt. Block client reads.
      // Other docs (global/dailySpecial/dynamicPricing/etc.) are read by the
      // customer site and stay world-readable.
      allow read: if docId != 'adminConfig';
      allow create, update: if isAdmin()
                            && docId in ['global', 'adminConfig', 'delivery', 'loyalty', 'theme', 'kiosk', 'dailySpecial', 'dynamicPricing'];
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // KIOSKS — POS terminal credentials
    // POS auth goes through Cloud Function /auth/kiosk-login (no direct read needed)
    // Admin panel still reads/manages kiosks directly
    // TODO: Move admin kiosk CRUD to Cloud Functions to fully lock this down
    // -------------------------------------------------------------------------
    // KIOSKS — POS terminal credentials
    // WARNING: This collection contains passwords. Read access is BLOCKED.
    // Auth goes through Cloud Function /auth/kiosk-login (server-side validation).
    // TODO: Move admin kiosk CRUD to Cloud Functions so admin panel doesn't need
    //       direct Firestore access. Until then, admin panel kiosk management
    //       will NOT work with these rules — use Firebase Console or Admin SDK.
    match /kiosks/{kioskId} {
      // Read stays admin-only — but now via Firebase Auth claim so the admin
      // panel can list/manage kiosks once signed in.
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['username', 'shopId', 'active', 'createdAt'])
                    && request.resource.data.username is string
                    && request.resource.data.username.size() <= 60
                    && request.resource.data.shopId is string
                    && request.resource.data.shopId.size() <= 60;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['active', 'passwordHash', 'username', 'lastLogin', 'updatedAt'])
                    && (!request.resource.data.keys().hasAny(['username'])
                        || (request.resource.data.username is string && request.resource.data.username.size() <= 60))
                    && (!request.resource.data.keys().hasAny(['active'])
                        || request.resource.data.active is bool);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COUPONS
    // Only usedCount may be updated (prevents tampering with discount/type/etc.)
    // -------------------------------------------------------------------------
    match /coupons/{code} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['usedCount']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // SHOPS — Multi-tenant shop config (readable by kiosk, writable by admin)
    // -------------------------------------------------------------------------
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAdmin()
                    && hasFields(['name', 'createdAt'])
                    && isString(request.resource.data.name);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'address', 'phone', 'hours', 'logo', 'settings', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // GIFT CARDS
    // -------------------------------------------------------------------------
    match /giftCards/{code} {
      allow read: if true;
      allow create: if false;  // Gift card creation restricted to admin/payment webhook
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['balance', 'redeemedAt'])
                    && request.resource.data.balance >= 0
                    && request.resource.data.balance <= resource.data.balance;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // REVIEWS — immutable after creation
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if hasFields(['rating', 'createdAt'])
                    && isNumber(request.resource.data.rating)
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // RESERVATIONS
    // -------------------------------------------------------------------------
    match /reservations/{resId} {
      allow read: if true;
      allow create: if hasFields(['name', 'phone', 'date', 'time', 'partySize', 'status', 'createdAt'])
                    && isString(request.resource.data.name)
                    && isString(request.resource.data.phone)
                    && request.resource.data.partySize is int
                    && request.resource.data.partySize > 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'tableId', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // INVENTORY — kitchen staff updates stock counts
    // -------------------------------------------------------------------------
    match /inventory/{itemId} {
      // Stock levels are internal data — admin/kitchen reads via Console
      allow read: if false;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
                    && request.resource.data.quantity >= 0;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // TABLES — status managed by kitchen/display
    // -------------------------------------------------------------------------
    match /tables/{tableId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','currentOrder','updatedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // MESSAGES — kitchen-FOH chat, immutable after creation
    // -------------------------------------------------------------------------
    match /messages/{msgId} {
      allow read: if true;
      allow create: if hasFields(['text', 'createdAt'])
                    && isString(request.resource.data.text);
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS — created by system/admin, updated (mark as read) by client
    // -------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if hasFields(['createdAt'])
                    && request.resource.data.keys().size() <= 10;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // REFERRALS
    // -------------------------------------------------------------------------
    match /referrals/{refId} {
      allow read: if true;
      allow create: if hasFields(['code', 'referrerId', 'createdAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['usageCount','credited']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // CATERING INQUIRIES — write-only by clients, admin reads via Console
    // -------------------------------------------------------------------------
    match /cateringInquiries/{id} {
      allow create: if hasFields(['name','phone','eventType','guestCount','date'])
                    && isString(request.resource.data.name)
                    && isString(request.resource.data.phone);
      allow read, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // DELIVERY PERSONS — credentials protected
    // READ BLOCKED from client — auth goes through Cloud Function /auth/delivery-login
    // Admin manages via Firebase Console or Admin SDK
    // -------------------------------------------------------------------------
    match /deliveryPersons/{phone} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // EXPENSES — admin-only, full read/write from admin panel
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && hasFields(['date', 'category', 'amount', 'description', 'createdAt'])
                    && isString(request.resource.data.date)
                    && isString(request.resource.data.category)
                    && isString(request.resource.data.description)
                    && isNumber(request.resource.data.amount)
                    && request.resource.data.amount > 0;
      allow update: if isAdmin()
                    && hasFields(['date', 'category', 'amount', 'description'])
                    && isNumber(request.resource.data.amount)
                    && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // STAFF — managed by admin panel (validate required fields)
    // -------------------------------------------------------------------------
    match /staff/{staffId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && hasFields(['name', 'role'])
                    && isString(request.resource.data.name)
                    && isString(request.resource.data.role);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'role', 'phone', 'active', 'shift', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // GROUP CARTS — shared ordering (validate structure)
    // -------------------------------------------------------------------------
    match /groupCarts/{cartId} {
      allow read: if true;
      allow create: if hasFields(['hostPhone', 'status', 'createdAt'])
                    && isString(request.resource.data.hostPhone);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['participants', 'status']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // SUBSCRIPTION PLANS — read by customers, managed by admin
    // -------------------------------------------------------------------------
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // SUBSCRIPTIONS — customer subscriptions
    // -------------------------------------------------------------------------
    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if hasFields(['planId', 'userPhone', 'createdAt'])
                    && isString(request.resource.data.planId)
                    && isString(request.resource.data.userPhone);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'renewedAt', 'cancelledAt', 'remainingDeliveries']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // BRANCHES — multi-branch support (future)
    // -------------------------------------------------------------------------
    match /branches/{branchId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // CHAT HISTORY — AI chatbot conversation context
    // -------------------------------------------------------------------------
    match /chatHistory/{id} {
      // Private conversations — readable only via Cloud Functions with phone verification
      allow read: if false;
      allow create: if hasFields(['userPhone', 'createdAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['messages', 'updatedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // MEAL PLANS — AI-generated saved meal plans
    // -------------------------------------------------------------------------
    match /mealPlans/{id} {
      // Private meal plans — readable only via Cloud Functions with phone verification
      allow read: if false;
      allow create: if hasFields(['userPhone', 'createdAt'])
                    && isString(request.resource.data.userPhone);
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // NEWSLETTER — write-only by clients (email subscriptions)
    // -------------------------------------------------------------------------
    match /newsletter/{email} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['email', 'subscribedAt'])
                    && isString(request.resource.data.email)
                    && request.resource.data.email.size() <= 254;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // POLLS — user votes
    // -------------------------------------------------------------------------
    match /polls/{pollId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['votes', 'totalVotes']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // FEEDBACK — post-order feedback (write-only)
    // -------------------------------------------------------------------------
    match /feedback/{fbId} {
      allow read: if false;
      allow create: if hasFields(['orderId', 'createdAt'])
                    && isString(request.resource.data.orderId)
                    && request.resource.data.keys().size() <= 15;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY — all other paths
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
