default_platform(:ios)

platform :ios do
  desc "Build and upload Amogha Cafe to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    app_id = ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe"

    # The App Store Connect API *Issuer ID* is an org-wide identifier, not a
    # secret (it's useless without the .p8 private key, which IS the secret in
    # APP_STORE_KEY_CONTENT). Default it here so the build works even when the
    # APP_STORE_ISSUER_ID repo secret is unset/empty. A real value in the
    # secret still takes precedence.
    issuer_id = ENV["APP_STORE_ISSUER_ID"].to_s
    issuer_id = "97d490f7-9127-4b9b-906f-3c093ab650fe" if issuer_id.strip.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: issuer_id,
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # --- Signing via match -----------------------------------------------------
    # match stores the distribution certificate's PRIVATE KEY (encrypted with
    # MATCH_PASSWORD) in a dedicated git repo (MATCH_GIT_URL). On the first run
    # with readonly:false it CREATES the cert + App Store profile via the API
    # key and pushes them encrypted to that repo; every run after reuses them.
    #
    # This is the architecture iOS CI requires: the private key must persist
    # between ephemeral runners. The earlier `cert`-only approach created a new
    # certificate every run and threw the key away (orphaned certs, Apple's
    # 2-3 cert limit) — match fixes that.
    #
    # Setup needed once (browser only, no Mac):
    #   1. Create an empty PRIVATE GitHub repo for certs, e.g. amogha-certs.
    #   2. Repo secret MATCH_GIT_URL — an HTTPS URL the macOS runner can clone,
    #      e.g. https://x-access-token:<PAT>@github.com/MukundaKatta/amogha-certs.git
    #   3. Repo secret MATCH_PASSWORD — any passphrase (the encryption key).
    match(
      type: "appstore",
      app_identifier: app_id,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      readonly: false,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => "match AppStore #{app_id}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build, upload to TestFlight, and submit for App Store review"
  lane :release do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )

    # Upload to TestFlight first (required before App Store submission)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )

    # Upload metadata and submit for App Store review
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "./fastlane/metadata",
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: true,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      },
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build release IPA without uploading (for testing)"
  lane :build_only do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )
  end
end
