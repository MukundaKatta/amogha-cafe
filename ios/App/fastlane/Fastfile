default_platform(:ios)

platform :ios do
  desc "Build and upload Amogha Cafe to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    # Install provisioning profile from App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Sync signing certificates and profiles
    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    # Increment build number (uses current timestamp for unique builds)
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    # Build the app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build release IPA without uploading (for testing)"
  lane :build_only do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )
  end
end
