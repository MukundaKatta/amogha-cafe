default_platform(:ios)

platform :ios do
  desc "Build and upload Amogha Cafe to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    app_id = ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe"

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # --- Signing WITHOUT match (no certs repo, no Mac seeding required) -------
    # Create/download the Apple Distribution certificate directly from the
    # App Store Connect API into the CI keychain. This is exactly the cert
    # that was missing on the local export ("No signing certificate
    # 'iOS Distribution' found").
    cert(
      api_key: api_key,
      keychain_path: ENV["KEYCHAIN_PATH"]
    )

    # Create/download an App Store provisioning profile for the bundle id.
    sigh(
      api_key: api_key,
      app_identifier: app_id,
      platform: "ios"
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    # Pin the project to manual signing with the cert + profile we just made,
    # so build_app uses them instead of Xcode cloud signing (which failed
    # locally with "Cloud signing permission error").
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: app_id,
      targets: ["App"]
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build, upload to TestFlight, and submit for App Store review"
  lane :release do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )

    # Upload to TestFlight first (required before App Store submission)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )

    # Upload metadata and submit for App Store review
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "./fastlane/metadata",
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: true,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      },
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build release IPA without uploading (for testing)"
  lane :build_only do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: ENV["APP_IDENTIFIER"] || "com.amoghahotels.cafe",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AmoghaCafe.ipa",
      clean: true
    )
  end
end
