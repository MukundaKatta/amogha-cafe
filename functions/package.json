{
  "name": "amogha-cafe-functions",
  "description": "Amogha Cafe REST API — Cloud Functions",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.0.0"
  },
  "private": true
}
